# Public (safe in client bundles)
NEXT_PUBLIC_SITE_URL=https://www.drjanduffy.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
NEXT_PUBLIC_GOOGLE_MAP_EMBED_URL=
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_CALLRAIL_ID=

# Server-only — rotate after React2Shell if the app was live on Next.js 15.5.3+ (see below)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Planned integrations (rotate when enabled)
# RESEND_API_KEY=
# FUB_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# V0_API_KEY=

# ---
# React2Shell post-patch secret rotation (Vercel: Project → Settings → Environment Variables)
# Priority if drjanduffy.com ran vulnerable Next.js 15.5.3 while publicly reachable:
# 1. KV_REST_API_TOKEN (Upstash) — regenerate in Upstash console, update Vercel Production
# 2. Any CRM/email/SMS API keys when those integrations are active
# 3. V0_API_KEY if used in server routes
# Public NEXT_PUBLIC_* IDs are low risk; still update if you prefer defense in depth.
# Guide: https://vercel.com/kb/bulletin/react2shell
# Verify versions: ./scripts/check-security-versions.sh
